# ==========================
# Algorand Network Configuration
# ==========================
NEXT_PUBLIC_ALGOD_TOKEN=
NEXT_PUBLIC_ALGOD_SERVER=https://testnet-api.4160.nodely.dev
NEXT_PUBLIC_ALGOD_PORT=443
NEXT_PUBLIC_ALGOD_NETWORK=testnet
NEXT_PUBLIC_INDEXER_SERVER=https://testnet-idx.4160.nodely.dev
NEXT_PUBLIC_INDEXER_PORT=443
NEXT_PUBLIC_INDEXER_TOKEN=

# AlgoKit Configuration (for backend scripts)
ALGOD_SERVER=https://testnet-api.4160.nodely.dev
ALGOD_TOKEN=
INDEXER_SERVER=https://testnet-idx.4160.nodely.dev
INDEXER_TOKEN=

# Network setting
NEXT_PUBLIC_ALGORAND_NETWORK=testnet
ALGORAND_NETWORK=testnet

# ==========================
# Contract IDs
# ==========================
# Deploy your contract first, then add the App ID here
NEXT_PUBLIC_AUTOPILOT_CONTRACT_APP_ID=your_app_id_here

# Liquidity Pool Contract
# Deploy using: cd Blockchain/projects/10x_Swap && python smart_contracts/liquidity_pool/deploy_config.py
NEXT_PUBLIC_POOL_APP_ID=your_pool_app_id_here
NEXT_PUBLIC_POOL_APP_ADDRESS=your_pool_app_address_here
POOL_APP_ID=your_pool_app_id_here
POOL_APP_ADDRESS=your_pool_app_address_here

# ==========================
# Deployment Accounts (KEEP PRIVATE!)
# ==========================
# This is YOUR main wallet - used for signing transactions and as the owner
# WARNING: Never commit your actual mnemonic to Git!
# Generate a new wallet at: https://testnet.algoexplorer.io/dispenser
DEPLOYER_MNEMONIC="your 25-word mnemonic phrase goes here"
ALGORAND_MNEMONIC="your 25-word mnemonic phrase goes here"

# ==========================
# Agent Wallet Encryption (KEEP SECRET!)
# ==========================
# Generate a secure 32-byte hex key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This encrypts all user agent wallet private keys in the database
# WARNING: Losing this key means losing access to all agent wallets!
AGENT_WALLET_ENCRYPTION_KEY=your_32_byte_hex_key_here

# ==========================
# Third-Party Services
# ==========================
# WalletConnect
# Get yours at: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# CoinGecko API
# Get yours at: https://www.coingecko.com/en/api/pricing
NEXT_PUBLIC_COINGECKO_API_KEY=your_coingecko_api_key
NEXT_PUBLIC_CRYPTO_API_URL=https://api.coingecko.com/api/v3
NEXT_PUBLIC_EXCHANGE_API_URL=https://api.coingecko.com/api/v3

# ==========================
# AI Configuration
# ==========================
# The AI provider to use ("openrouter" or "openai")
AI_PROVIDER=openrouter
AI_MODEL=anthropic/claude-3-haiku

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_key_here

# ==========================
# Database (Turso)
# ==========================
# Sign up at: https://turso.tech/
DB_DRIVER=turso
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ==========================
# General Application Settings
# ==========================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Generate random secrets with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=your_random_cron_secret_here
NEXT_PUBLIC_CRON_SECRET=your_random_cron_secret_here
MIGRATE_SECRET=your_random_migrate_secret_here

# ==========================
# MCP Analytics Server (Optional)
# ==========================
MCP_ANALYTICS_URL=http://localhost:8080
MCP_BASE_URL=http://localhost:8080
MCP_ANALYTICS_API_KEY=your_mcp_api_key_here
MCP_PORT=8080
