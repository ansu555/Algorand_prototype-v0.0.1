// contract.LiquidityPoolContract.get_pool_key(asset_1_id: uint64, asset_2_id: uint64) -> bytes:
get_pool_key:
    // contract.py:68-69
    // @subroutine
    // def get_pool_key(self, asset_1_id: UInt64, asset_2_id: UInt64) -> Bytes:
    proto 2 1
    // contract.py:74-75
    // # Sort asset IDs to ensure consistent key
    // if asset_1_id < asset_2_id:
    frame_dig -2
    frame_dig -1
    <
    bz get_pool_key_else_body@2
    // contract.py:76
    // key_data = op.itob(asset_1_id) + op.itob(asset_2_id)
    frame_dig -2
    itob
    frame_dig -1
    itob
    concat

get_pool_key_after_if_else@3:
    // contract.py:80-81
    // # Use first 32 bytes of sha256 hash as key
    // return op.sha256(key_data)
    sha256
    retsub

get_pool_key_else_body@2:
    // contract.py:78
    // key_data = op.itob(asset_2_id) + op.itob(asset_1_id)
    frame_dig -1
    itob
    frame_dig -2
    itob
    concat
    b get_pool_key_after_if_else@3
